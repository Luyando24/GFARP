# Example environment variables file
# Copy this file to .env and fill in your actual values
# DO NOT commit the actual .env file to version control

# Builder.io API Key
# https://www.builder.io/c/docs/using-your-api-key
VITE_PUBLIC_BUILDER_KEY=your_builder_public_key_here
PING_MESSAGE=your_ping_message_here

# Authentication and field encryption (server-only, use independent random values)
JWT_SECRET=replace_with_at_least_32_random_characters
FIELD_ENCRYPTION_KEY=replace_with_a_different_random_secret
CORS_ORIGINS=https://your-app.example.com
CRON_SECRET=replace_with_a_long_random_scheduler_secret

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/database_name
DB_HOST=localhost
DB_PORT=5432
DB_NAME=database_name
DB_USER=user
DB_PASSWORD=password

# NRC Hashing Salt (for student privacy)
NRC_SALT=your_secure_salt_here

# Supabase Configuration (server-side Storage access)
# Get these from your Supabase project dashboard. Never expose the service key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key_here

# Email Service Configuration (Resend)
# Keep the API key server-only and verify the sender domain in Resend.
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=notifications@soccercircular.com
RESEND_FROM_NAME=Soccer Circular
RESEND_REPLY_TO=support@soccercircular.com

# Client URL for email links
CLIENT_URL=http://localhost:8080

# Stripe Configuration
# Get these from your Stripe dashboard
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Vite environment variables for Stripe (client-side)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
